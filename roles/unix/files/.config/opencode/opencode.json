{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "c24-llm-proxy-openai/gpt-5-mini",
  "provider": {
    "gemma-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Gemma 4 E2B",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "ggml-org/gemma-4-E2B-it-GGUF:Q8_0": {
          "name": "Gemma 4 E2B IT (Q8_0)",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image", "audio"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "cd": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "dirname": "allow",
      "dirname *": "allow",
      "basename": "allow",
      "basename *": "allow",
      "which": "allow",
      "which *": "allow",
      "file": "allow",
      "file *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "uniq": "allow",
      "uniq *": "allow",
      "cut": "allow",
      "cut *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "printf": "allow",
      "printf *": "allow",
      "date": "allow",
      "date *": "allow",
      "sleep": "allow",
      "sleep *": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname": "allow",
      "uname *": "allow",
      "printenv": "allow",
      "printenv *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker images": "allow",
      "docker images *": "allow",
      "docker logs": "allow",
      "docker logs *": "allow",
      "docker inspect": "allow",
      "docker inspect *": "allow",
      "docker compose ps": "allow",
      "docker compose ps *": "allow",
      "docker compose logs": "allow",
      "docker compose logs *": "allow",
      "docker compose config": "allow",
      "docker compose config *": "allow"
    }
  }
}
